package com.kh.chap01_list.part02_mvc.view;

import java.util.Scanner;

// View : 화면을 담당하는 코드만 작성할 것
// > 즉, 출력문, 입력문을 최대한 활용!!
public class MusicView { // 클래스 영역 시작

	// 필드부 - 전역변수 셋팅
	private Scanner sc = new Scanner(System.in);
	
	// 메인화면을 담당하는 메소드
	// > 메인화면 : 프로그램 실행 시 제일 처음으로 보여지는 화면
	public void mainMenu() {

		// 사용자가 종료하기 전까지 절대 끝나지 않도록 유도 (무한반복)
		
		while(true) { // 메소드 영역 끝
		
			System.out.println("~~~ 소라바다 ~~~"); //
			//
			System.out.println("1. 새로운 곡 추가");
			System.out.println("2. 곡 전체 조회");
			System.out.println("3. 특정 곡 검색");
			System.out.println("4. 특정 곡 삭제");
			System.out.println("5. 특정 곡 수정");
			System.out.println("0. 프로그램 종료");
			
			System.out.println("-----------------");
			
			System.out.print("메뉴 입력 : ");
			int menu = sc.nextInt();
			sc.nextLine();
		
			// 지금부터 사용자가 입력한 메뉴 번호에 따라 알맞은 화면이 보여지게끔 유도 (switch문)
			switch(menu) {
			case 1 :
				insertMusic();
				break;
			case 2 :
				System.out.println("2. 곡 전체 조회");
				break;
			case 3 :
				System.out.println("3. 특정 곡 검색");
				break;
			case 4 :
				System.out.println("4. 특정 곡 삭제");
				break;
			case 5 :
				System.out.println("5. 특정 곡 수정");
				break;
			case 0 :
				System.out.println("프로그램을 종료합니다. 안녕히 가세요.");
				return;
			default :
				System.out.println("없는 메뉴를 입력했습니다. 다시 입력해 주세요.");
			}
			
		}
		
	} // 메소드 영역 끝

} // 클래스 영역 끝