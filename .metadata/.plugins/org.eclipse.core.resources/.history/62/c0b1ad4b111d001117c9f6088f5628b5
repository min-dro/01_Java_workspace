package com.kh.controller;

import java.io.EOFException;
import java.io.FileInputStream;
import java.io.FileOutputStream;
import java.io.IOException;
import java.io.InputStream;
import java.io.ObjectInputStream;
import java.io.ObjectOutputStream;
import java.util.ArrayList;
import java.util.Arrays;

import com.kh.model.vo.Member;

public class MemberController2 { // 클래스 영역 시작
	
	private Member[] memberList = new Member[10];
	private int size = 0;
	public int idCheck(String userId) { // 메소드 영역 시작
		try(ObjectInputStream ois = new ObjectInputStream(new FileInputStream("member.dat"))){
			ois.readObject();
		} catch(EOFException e){
		
		} catch(IOException e) {
			e.printStackTrace();
		} catch(ClassNotFoundException e) {
			e.printStackTrace();
		}
		for(int i = 0; i < size; i++) {
			if(userId.equals(memberList[i].getUserId())) {
				return 1;
			}
		}
		
		return 0;
	} // 메소드 영역 끝

	public int insertMember(String userId, String userPwd, String userName, int age, char gender, String email,
			String phone) { // 메소드 영역 시작
		
		int userNo = size + 1;
		
		if(memberList.length == size) {
			memberList = Arrays.copyOf(memberList, memberList.length * 2);
		}
		memberList[size] = new Member(userNo, userId, userPwd, userName, age, gender, email, phone);

		try(ObjectOutputStream oos = new ObjectOutputStream(new FileOutputStream("userlist.txt"))){

			oos.writeObject(memberList[size++]);

		} catch(IOException e) {
			e.printStackTrace();
		}
		
		return userNo;
		
	} // 메소드 영역 끝

	public Member[] selectMemberList() { // 메소드 영역 시작
		
		return memberList;
	} // 메소드 영역 끝

	public Member searchMemberByld(String userId) { // 메소드 영역 시작
		for(int i = 0; i < memberList.size(); i++) {
			if(userId.equals(memberList.get(i).getUserId())) {
				return memberList.get(i);
			}
		}
		return null;
	} // 메소드 영역 끝

	public ArrayList<Member> searchMemberByName(String keyword) { // 메소드 영역 시작
		ArrayList<Member> list = new ArrayList<>();
		for(int i = 0; i < memberList.size(); i++) {
			if(memberList.get(i).getUserName().contains(keyword)) {
				list.add(memberList.get(i));
			}
		}
		return list;
	} // 메소드 영역 끝

	public int initMemberPwd(String userId) { // 메소드 영역 시작
		for(int i = 0; i < memberList.size(); i++) {
			if(userId.equals(memberList.get(i).getUserId())) {
				memberList.get(i).setUserPwd("passwordKH@123");
				return 1;
			}
		}
		return 0;
	} // 메소드 영역 끝

	public int deleteMember(String userId) { // 메소드 영역 시작
		for(int i = 0; i < memberList.size(); i++) {
			if(userId.equals(memberList.get(i).getUserId())) {
				memberList.remove(i);
				return 1;
			}
		}
		return 0;
	} // 메소드 영역 끝
	
} // 클래스 영역 끝
