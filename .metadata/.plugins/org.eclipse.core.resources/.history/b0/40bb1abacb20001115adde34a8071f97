package com.kh.model.vo;

import java.io.Serializable;

public class Keyboard implements Serializable{ // 클래스 영역 시작

	private String brand; 
	private String modelName;
	private int keyCount;
	private String switchType;
	private String connection;
	private int price;
	private char rgb;
	private String detail;
	
	public Keyboard() {}


	public Keyboard(String brand, String modelName, int keyCount, String switchType, String connection, int price,
			char rgb, String detail) {
		super();
		this.brand = brand;
		this.modelName = modelName;
		this.keyCount = keyCount;
		this.switchType = switchType;
		this.connection = connection;
		this.price = price;
		this.rgb = rgb;
		this.detail = detail;
	}


	public String getBrand() {
		return brand;
	}


	public void setBrand(String brand) {
		this.brand = brand;
	}


	public String getModelName() {
		return modelName;
	}


	public void setModelName(String modelName) {
		this.modelName = modelName;
	}


	public int getKeyCount() {
		return keyCount;
	}


	public void setKeyCount(int keyCount) {
		this.keyCount = keyCount;
	}


	public String getSwitchType() {
		return switchType;
	}


	public void setSwitchType(String switchType) {
		this.switchType = switchType;
	}


	public String getConnection() {
		return connection;
	}


	public void setConnection(String connection) {
		this.connection = connection;
	}


	public int getPrice() {
		return price;
	}


	public void setPrice(int price) {
		this.price = price;
	}


	public char getRgb() {
		return rgb;
	}


	public void setRgb(char rgb) {
		this.rgb = rgb;
	}

	public String getDetail() {
		return detail;
	}
	
	public void setDetail(String detail) {
		this.detail = detail;
	}
	
	@Override
	public String toString() {
		if(rgb == 'y') {
			rgb = 'O';
		} else {
			rgb = 'X';
		}
		String detail = "";
		if(this.detail != null) {
			detail = "\n상세 내용 :  " + this.detail;
		}
		return "제조사 : " + brand + ", 모델명 : " + modelName + ", 키 갯수 : " + keyCount + ", 스위치 방식 : "
				+ switchType + ", 연결 방식 : " + connection + ", 가격 : " + price + ", RGB : " + rgb + detail +"]";
	}


} // 클래스 영역 끝
