package com.kh.chap03_map.part01_hashMap.run;

import java.util.HashMap;

import com.kh.chap03_map.part01_hashMap.model.vo.Snack;

// HashMap 사용법
public class MapRun { // 클래스 영역 시작

	public static void main(String[] args) { // 메소드 영역 시작
		// 제네릭 설정 전
		// HashMap 객체 먼저 생성
		HashMap /* <Object, Object> */ hm1 = new HashMap();
		
		// 명심할 사항 : 클래스간의 계층구조를 보면 List 나 Set 계열은 Collection 을 구현한 클래스
		//	 		  Map 계열은 Collection 계열이 아님!!
		
		// 차이점 : List 나 Set 계열은 value 만 저장 가능, Map 계열은 key + value 로 저장해야함
		//		  List 나 Set 계열은 데이터를 추가할 때 add 메소드 이용, Map 계열은 put 메소드 이용
		
		// K == Object
		// V == Object
		// > 제네릭 설정을 아직 안했음!!
		
		// 1. put(K key, V value
		// > Map 공간에 key + value 세트로 데이터를 추가하는 메소드
		hm1.put("123", "첫번째 밸류");
		hm1.put(9, 1.234);
		hm1.put('a', "첫번째 밸류");
		hm1.put("123", "두번째 밸류");
		
		System.out.println(hm1 /* .toString() */);
		// > {a=첫번째 밸류, 123=두번째 밸류, 9=1.234)
		// > Collection 자식 계열들은 [] 안에 출력, Map 계열은 {} 안에 출력
		// > 저장 순서 유지 X
		// > value 값은 중복 허용이 됨!! key 값은 중복 허용이 안된!!
		//	 (만약 key 가 중복됬을 경우에는 마지막으로 put 된 데이터로 덮어씌워짐!!)
		// > 마찬가지로 아직 제네릭 설정 전이기 때문에 key 든 value 든 간에 아무 자료형의 값이나 다 넣을 수 있음!!
		
		System.out.println("-------------");
		
		// 제네릭 설정 후
		
		// * Map 계열의 제네릭을 설정한 경우
		// > Key 에 대한 자료형과 Value 에 대한 자료형 둘다 각각 지정하고 넘어가야함!!
		HashMap<String, Snack> hm2 = new HashMap<>();
		
		// K == String
		// V == Snack
		
		// 1. put(K key, V value)
		// > Map 공간에 데이터를 key + value 형식으로 추가해주는 메소드
		hm2.put("빅파이", new Snack("초코딸기맛", 200));
		hm2.put("칙촉", new Snack("초코칩맛", 150));
		hm2.put("새우깡", new Snack("짠맛", 500));
		hm2.put("크리스피롤", new Snack("고소한맛", 100));
		// hm2.put(123, "아무거나");
		
		System.out.println(hm2);
		// > 저장 순서 유지
		// > 제네릭 설정 후 Key + value 모두 설정된 타입으로만 put 할 수 있음!!
		
		hm2.put("새우깡", new Snack("매운맛", 600));
		
		System.out.println(hm2);
		// > 중복된 key 값의 value 값으로 덮어씌워짐!!
		
		// 2. get(Object key) : V
		// > Map 공간에서 해당 키값에 대한 value 값을 반환해주는 메소드
		System.out.println(hm2.get("빅파이"));

	} // 메소드 영역 끝

} // 클래스 영역 끝
