package com.kh.chap01_list.part01_arrayList.run;

import java.util.ArrayList;
import java.util.List;

import com.kh.chap01_list.part01_arrayList.model.vo.Music;

/*
 * * 컬렉션 (Collection)
 * > "자료구조" 가 내장되어있는 클래스로 
 * 	 자바에서 제공하는 "자료구조" 를 담당하는 "프레임워크" 이다.
 * 
 * - 자료구조 : 방대한 데이터들을 효율적 (구조적) 으로 다룰 때 필요한 개념
 * - 프레임워크 : 효율적인 기능들이 이미 코드로 정의되어있는 틀, 뼈대
 * 
 * > 정리해보면
 * 	 데이터들이 새로이 추가 되거나, 삭제가 되거나, 수정이 되는 기능 들이 이미 코드로 정의되어있는 틀이 있다.
 * 	 == "컬렉션"
 * 
 * > 우리는 그동안
 * 	 다량의 데이터들을 관리하고자 할 때 "배열" 을 가지고 충분히 사용했었음!!
 * > 단, 배열의 단점이 생각보다 크기 때문에 그 단점을 보완한 것이 컬렉션!!
 * 
 * * 배열과 컬렉션의 차이점
 * - 배열의 단점
 * 1. 한번 지정된 크기는 변경이 불가
 * 	  새로운 값을 추가하고자 할 때 크기가 오벌될 경우 새로운 크기의 배열을 새롭게 만들고,
 * 	  기존의 내용을 깊은복사 후 추가해야함
 * 2. 배열 중간 위치에 새로운 데이터를 추가하거나 삭제하는 경우
 * 	  기존의 값들을 앞으로 땡겨오거나 뒤로 밀어주는 코드를 일일이 짜야 함!!
 * 3. 한 타입의 값들먼 저장 가능
 * 
 * - 컬렉션의 장점
 * 1. 크기에 제약이 없다.
 * 	  크기를 지정해줄 필요도 없고, 만일 크기지정을 하더라도 알아서 크기가 늘어나면서 새로운 데이터를 추가해주는 코드가
 * 	  이미 작성되어 있음 (쓰란 데로만 가져다 쓰면 됨)
 * 2. 중간에 값을 추가하거나 삭제하는 경우 값을 앞으로 땡겨오거나 뒤로 밀어주는 코드가 이미 메소드로 정의되어있음
 * 3. 기본적으로 여러 타입의 데이터들을 저장할 수 없음
 * 	  (단, 제네릭 설정을 통해서 한 타입의 데이터들만 담기게끔도 유도할 수 있음)
 * 
 * > 즉, 배열의 단점을 보완하기 위해 개발자인 내가 직접 코드를 짜서 쓸 수 있지만
 * 	 이미 선배 개발자들이 쓰라고 메소드 단위로 코드를 다 짜봤음!! 안 쓸 필요가..? 없음!!
 * 
 * * 배열 VS 컬렉션을 써야 하는 경우
 * 배열 : 방대한 데이터들을 단지 담아만 두고 "조회" 만 할 목적
 * 컬렉션 : 방대한 데이터들이 빈번하게 "추가", "수정", "삭제" 가 될 거 같다?
 * 
 * * 컬렉션의 분류
 * Collection 의 자식 계열 - List, Set 계열
 * Map 계열
 * 
 * * List 계열
 * : 담고자 하는 값 (value) 만 저장 / 값 저장 시 순서 유지 (index 개념 있음, 한줄로 줄세우겠다) / 중복값 허용
 * 예) ArrayList, Vector, LinkedList > ArrayList 가 제일 많이 쓰임!!
 * 
 * * Set 계열
 * : 담고자 하는 값 (value) 만 저장 / 값 저장 시 순서 유지 X (index 개념 없음, 한줄로 세우지 않겠다) / 중복값 허용 X
 * 
 * * Map 계열
 * : 키 (key) + 담고자 하는 값 (value) 세트로 저장 / 값 저장 시 순서 유지 X (index 개념 없음, 한줄로 세우지 않겠다) /
 * 	 value 에 대해서만 중복값 허용 O, key 만 중복닶 허용 X
 * 예) HashMap, HashTable, Properties, ... > HashMap, Properties 가 제일 많이 쓰임!!
 * 
 * > 사용법은 계열들 마다 비슷비슷함!!
 */

// ArrayList 사용법
public class ListRun { // 클래스 영역 시작

	public static void main(String[] args) { // main 영역 시작
		
		// ArrayList 객체 먼저 생성
		
		// ArrayList list = new ArrayList();
		// > 기본생성자로 객체 생성 시 내부적으로 크기 10칸짜리 Object 배열이 만들어짐!!
		
		ArrayList list = new ArrayList(3);
		// > 매개변수생성자로 객체 생성 시 내부적으로 크기 3칸짜리 Object 배열이 만들어짐!!
		
		System.out.println(list /* .toString() */); // []
		// > 안에 아무것도 없는 상태 (비어있다)
		
		// E : Element 의 약자 (제네릭)
		// E 가 의미하는 것 == Object 타입
		// > 아직 제네릭 설정 방법을 배주지 않아서 기본값인 Object 타입을 지정했던 것
		
		// 1. add(E e)
		// > 해당 리스트의 끝에 전달된 e 를 추가시켜주는 메소드
		list.add(new Music("BANG BANG", "아이브")); // [0]
		list.add(new Music("404 (New Era)", "키키")); // [1]
		list.add(new Music("Good Goodbye", "화사")); // [2]
		list.add("끝");
		
		System.out.println(list);
		// > 순서가 유지되면서 값이 추가됨 (각 index 에 담겨있음)
		//	 크기에 제약이 없음
		//	 다양한 타입의 값 추가 기능
		
		// 2. add(int index, E e)
		// > 리스트에 전달되는 index 번쨰 자이에 전달되는 e 를 추가시켜주는 메소드 (오버로딩)
		list.add(1, new Music("Drowning", "WOODS"));
		
		System.out.println(list);
		// > 중간에 값 추가 시 알아서 기존의 값들을 뒤로 땡겨주는 작업이 내부적으로 진행됨
		
		// 3. set(int index, E e)
		// > 리스트에 해당 index 자리의 값을 전달되는 e 로 변경시켜주는 메소드
		list.set(0, new Music("타임캡슐", "다비치"));
		
		System.out.println(list);
		
		// 4. remove(int index)
		// > 리스트에 해당 index 자리의 값을 삭제시켜주는 메소드
		list.remove(1);
		
		System.out.println(list);
		// 중간에 값 삭제 시 내부적으로 데이터들을 앞으로 땡겨오는 작업이 내부적으로 진행됨
		
		// 5. size()
		// > 현재 리스트에 담겨있는 데이터의 갯수를 반환해주는 메소드
		System.out.println("리스트에 담긴 데이터 수 : " + list.size()); // 4
		System.out.println("리스트의 마지막 인덱스 : " + (list.size() - 1)); // 3
		// > 항상 마지막 인덱스 == 크기 - 1
		
		// 6. get(int index) : E
		// > 리스트로부터 해당 index 번째 자리의 데이터를 반환해주는 메소드
		// Object obj = list.get(0);
		// Music m = (Music)list.get(0); // 다형성 (DownCasting, 강제형변환)
		// System.out.println(m)
		System.out.println(list.get(0) /* . toString() */);
		
		// 제목만 보고 싶은 경우?
		System.out.println(((Music) list.get(0)).getTitle());
		// > DownCasting 을 정확히 한 후 해당 필드의 getter 메소드 호출
		
		System.out.println("---------------------------------");
		
		// 0번 ~ 마지막 인덱스 까지의 데이터를 모두 출력 (반복문)
		// for문
		for(int i = 0; i < list.size(); i++) {
			
			System.out.println(list.get(i));
		}
		
		System.out.println("-----------------------------------");
		
		// 향상된 for문 (foreach문) - 배열 뿐만 아니라 List 에서도 사용 가능
		// for(변수선언문 : 배열명)
		// for(변수선언문 : 리스트명)
		for(Object o : list) {
			
			System.out.println(o);
		}
		
		System.out.println("-----------------------------------");
		
		// 7. subList(int beginIndex, int endIndex) : List
		// > 해당 리스트로부터 beginIndex 에서 endIndex - 1 까지의 데이터들을 추출해서 새로운 List 로 만들어서 반환해주는 메소드
		// 	 (문자열의 substring 메소드의 리스트 버전)
		List sub = list.subList(0, 2);
		
		System.out.println(sub);
		// > endIndex 는 제외하고 가지고옴!! (endIndex - 1 까지만 추출)
		
		System.out.println("-----------------------------------");
		
		// 8. addAll(Collection c)
		// > 해당 리스트에 다른 컬렉션에 있는 데이터들을 통째로 추가해주는 메소드
		//	 (문자열의 concat 메소드의 리스트 버전)
		list.addAll(sub);
		
		System.out.println(list);
		// > Collection c 로 통째로 추가할 데이터를 넘긴다!!
		//	 List 계열을 넘길 수도 있고, Set 계열 또한 제시할 수 있다!!
		
		System.out.println("-----------------------------------");
		
		// 9. isEmpty() : boolean
		// > 해당 리스트가 비어있지 묻는 메소드
		//	 비어있으면 true, 비어있지 않으면 false 를 반환
		System.out.println("리스트가 비어있습니까 : " + list.isEmpty()); // false
		
		// 10. clear()
		// > 해당 리스트를 싹 비워주는 메소드
		list.clear();
		
		System.out.println("리스트가 비어있습니까 : " + list.isEmpty()); // true
		System.out.println("size : " + list.size()); // 0
	} // main 영역 끝

} // 클래스 영역 끝
