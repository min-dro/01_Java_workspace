package com.kh.controller;

import java.util.ArrayList;

import com.kh.model.vo.Member;

public class MemberController2 { // 클래스 영역 시작
	
	private ArrayList<Member> memberList = new ArrayList<>();
	
	public int idCheck(String userId) { // 메소드 영역 시작
		
		for(int i = 0; i < memberList.size(); i++) {
			if(userId.equals(memberList.get(i).getUserId())) {
				return 1;
			}
		}
		
		return 0;
	} // 메소드 영역 끝

	public int insertMember(String userId, String userPwd, String userName, int age, char gender, String email,
			String phone) { // 메소드 영역 시작
		int userNo = 0;
		if(memberList.isEmpty()) {
			userNo = 0;
		} else {
			userNo = memberList.get(memberList.size()).getUserNo() + 1;
		}
		int before = memberList.size();
		memberList.add(new Member(userNo, userId, userPwd, userName, age, gender, email, phone));
		int after = memberList.size();
		return after - before;
	} // 메소드 영역 끝

	public ArrayList<Member> selectMemberList() { // 메소드 영역 시작
		
		return memberList;
	} // 메소드 영역 끝

	public Member searchMemberByld(String userId) { // 메소드 영역 시작
		for(int i = 0; i < memberList.size(); i++) {
			if(userId.equals(memberList.get(i).getUserId())) {
				return memberList.get(i);
			}
		}
		return null;
	} // 메소드 영역 끝

	public ArrayList<Member> searchMemberByName(String keyword) { // 메소드 영역 시작
		ArrayList<Member> list = new ArrayList<>();
		for(int i = 0; i < memberList.size(); i++) {
			if(memberList.get(i).getUserName().contains(keyword)) {
				list.add(memberList.get(i));
			}
		}
		return list;
	} // 메소드 영역 끝

	public int initMemberPwd(String userId) { // 메소드 영역 시작
		for(int i = 0; i < memberList.size(); i++) {
			if(userId.equals(memberList.get(i).getUserId())) {
				memberList.get(i).setUserPwd("passwordKH@123");
				return 1;
			}
		}
		return 0;
	} // 메소드 영역 끝

	public int deleteMember(String userId) { // 메소드 영역 시작
		for(int i = 0; i < memberList.size(); i++) {
			if(userId.equals(memberList.get(i).getUserId())) {
				memberList.remove(i);
				return 1;
			}
		}
		return 0;
	} // 메소드 영역 끝
	
} // 클래스 영역 끝
