package com.kh.chap01_list.part02_mvc.view;

import java.util.ArrayList;
import java.util.Scanner;

import com.kh.chap01_list.part02_mvc.controller.MusicController;
import com.kh.chap01_list.part02_mvc.model.vo.Music;

// View : 화면을 담당하는 코드만 작성할 것
// > 즉, 출력문, 입력문을 최대한 활용!!
public class MusicView { // 클래스 영역 시작

	// 필드부 - 전역변수 셋팅
	private Scanner sc = new Scanner(System.in);
	
	private MusicController mc = new MusicController();
	
	// 메인화면을 담당하는 메소드
	// > 메인화면 : 프로그램 실행 시 제일 처음으로 보여지는 화면
	public void mainMenu() {

		// 사용자가 종료하기 전까지 절대 끝나지 않도록 유도 (무한반복)
		
		while(true) { // 메소드 영역 끝
		
			System.out.println("\n~~~ 소라바다 ~~~");
			System.out.println("1. 새로운 곡 추가");
			System.out.println("2. 곡 전체 조회");
			System.out.println("3. 특정 곡 검색");
			System.out.println("4. 특정 곡 삭제");
			System.out.println("5. 특정 곡 수정");
			System.out.println("0. 프로그램 종료");
			
			System.out.println("-----------------");
			
			System.out.print("메뉴 입력 : ");
			int menu = sc.nextInt();
			sc.nextLine();
		
			// 지금부터 사용자가 입력한 메뉴 번호에 따라 알맞은 화면이 보여지게끔 유도 (switch문)
			switch(menu) {
			case 1 :
				insertMusic();
				break;
			case 2 :
				selectMusicList();
				break;
			case 3 :
				searchMusic();
				break;
			case 4 :
				deleteMusic();
				break;
			case 5 :
				System.out.println("5. 특정 곡 수정");
				break;
			case 0 :
				System.out.println("프로그램을 종료합니다. 안녕히 가세요.");
				return;
			default :
				System.out.println("없는 메뉴를 입력했습니다. 다시 입력해 주세요.");
			}
			
		} 
		
	} // mainMenu 끝 // 메소드 영역 끝

	// 1. 새로운 곡을 추가시킬 수 있는 화면
	public void insertMusic() { // 메소드 영역 시작
		
		System.out.println("\n--- 곡 추가 ---");
		
		// 추가할 곡의 제목과 가수명을 입력받기!!
		System.out.print("곡명 입력 : ");
		String title = sc.nextLine();
		
		System.out.print("가수명 입력 : ");
		String artist = sc.nextLine();
		
		// title, artist 를 하나의 Music 객체로 묶어야 함!! (가공) --> 저장소에 그대로 집어 넣기!!
		// > 이 과정부터는 실질적인 기능 담당용 코드이기 때문에 View 단에서 작성 X / Controller 에서 진행 O
		
		// MusicController mc = new MusicController();
		mc.insertMusic(title, artist);
		
		System.out.println("성공적으로 추가되었습니다.");
	} // insertMusic 끝 // 메소드 영역 끝
	
	// 2. 전체 곡을 조회할 수 있는 화면 담당 메소드
	public void selectMusicList() { // 메소드 영역 시작
		
		System.out.println("\n--- 전체 곡 조회 ---");
		
		// MusicController 내부의 저장소로부터 전체 음악 정보를 불러와서
		// 출력해주는 코드를 적어주면 됨!!
		
		// MusicController mc = new MusicController();
		ArrayList<Music> list = mc.selectMusicList();
		
		// View 단인 여기에서 반복문과 출력문을 작성!!
		// > 출력 전 저장된 곡이 있는지 검사하고 출력
		if(list.isEmpty()) {
			// > 리스트가 비어있을 경우 (저장된 곡이 단 한곡도 없을 경우_
			
			System.out.println("현재 존재하는 곡이 없습니다.");
			
		} else {
			// > 리스트가 비어있지 않을 경우 (저장된 곡이 한곡 이상 있을 경우)

			for(int i = 0; i < list.size(); i++) {
				System.out.println(list.get(i));
			}
			
			System.out.println("---------------");
			System.out.println("총 " + list.size() + "곡");
		}
		
	} // selectMusicList 끝 // 메소드 영역 끝
	
	// 3. 특정 곡을 검색할 수 있는 화면 담당 메소드
	public void searchMusic() { // 메소드 영역 시작
		
		System.out.println("\n--- 특정 곡 검색 ---");
		
		System.out.print("검색할 곡명 키워드 : ");
		String keyword = sc.nextLine();
		
		// 입력받은 검색어를 Controller 로 넘기면서 검색 기능을 요청
		// > 검색어에 해당하는 데이터들만 추려서 리턴값으로 다시 돌려받을 예정
		//	 (Controller 에서 출력 X)
		ArrayList<Music> searchedList = mc.searchMuisc(keyword);
		if(searchedList.isEmpty()) {
			// 검색 결과가 하나도 없을 경우
			
			System.out.println("검색 결과가 없습니다.");
			
		} else {
			// > 검색 결과가 하나라도 있을 경우
			
			System.out.println("검색 결과는 총 " + searchedList.size() + "건 입니다.");
			System.out.println("-----------");
			
			for(Music m : searchedList) {
				
				System.out.println(m);
			}
		}
		
	} // searchMusic 끝 // 메소드 영역 끝
	

	public void deleteMusic() { // 메소드 영역 끝
		
		System.out.println("\n--- 곡 삭제 ---");
		
		System.out.println("삭제할 곡명 : ");
		String title = sc.nextLine();
		
		int result = mc.deleteMusic(title);
		
		if(result > 0) {
			// > 삭제가 진행됬을 경우
			
			System.out.println("성공적으로 삭제되었습니다.");
			
		} else {
			// 삭제가 진행되지 않을 경우 (삭제할 곡을 찾지 못한 경우)
			
			System.out.println("삭제할 곡을 찾지 못했습니다.");
		}
		
	} // deleteMusic 끝 // 메소드 영역 끝
	
	// 5. 특정 곡을 수정할 수 있는 화면 담당 메소드
	public void updateMusic() {
		
		System.out.println("\n--- 곡 수정 ---");
		
		// 수정 기능은 보통
		// "뭐를" "어떻게" "수정할껀지"
		// 기존 곡명, 수정할 곡명, 수정할 가수명 입력받기
		
		System.out.print("기존 곡명 : ");
		String title = sc.nextLine();
		
		System.out.println("수정할 곡명 : ");
		String upTitle = sc.nextLine();
		
		System.out.println("수정할 가수명");
		String upArtist = sc.nextLine();
		
		mc.updateMusic(title, upTitle, upArtist);
	}
} // 클래스 영역 끝